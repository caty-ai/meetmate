# systemd user unit template for meetmate agents.
# Do not edit this file directly — use install-service.sh to generate a
# concrete unit with proper values for your agent instance.

[Unit]
Description=meetmate agent ({{LABEL}})

[Service]
ExecStart="{{NODE_PATH}}" src/server.js
WorkingDirectory={{WORKING_DIR}}
Restart=always
RestartSec=10
StandardOutput=append:{{LOG_DIR}}/meet-server.stdout.log
StandardError=append:{{LOG_DIR}}/meet-server.stderr.log
Environment=PATH={{NODE_DIR}}:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
