<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for AI Meet Participant agents.
  Do not edit this file directly — use install-launchagent.sh to generate
  a concrete plist with proper values for your agent instance.

  Placeholders:
    {{LABEL}}       — LaunchAgent label (e.g. ai.openclaw.meet-server)
    {{WORKING_DIR}} — Absolute path to the agent's working directory
    {{NODE_PATH}}   — Absolute path to the node binary
    {{LOG_DIR}}     — Absolute path to the log directory
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_PATH}}</string>
    <string>src/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{WORKING_DIR}}</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/meet-server.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/meet-server.stderr.log</string>

  <!-- PATH is supplementary — the server is launched via {{NODE_PATH}} (absolute),
       so this mainly helps child processes (e.g. git, curl) find common binaries. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
