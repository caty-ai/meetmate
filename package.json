{
  "name": "ai-meet-participant",
  "version": "0.1.0",
  "description": "AIエージェントがGoogle Meet/Zoomにリアルタイム参加し音声で対話するブリッジサーバー",
  "private": true,
  "files": [
    "bin/",
    "src/",
    "public/",
    "assets/avatar.png",
    "assets/fillers/",
    "config.json.example",
    ".env.example",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "ai-meet": "bin/ai-meet.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:meet": "node src/index.js",
    "dev": "node --watch src/server.js",
    "test:meet:repro": "node --test test/meet-multi-participant-repro.test.js"
  },
  "dependencies": {
    "@deepgram/sdk": "4.7.0",
    "dotenv": "^17.0.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
