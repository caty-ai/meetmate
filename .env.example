# AI Meet Participant - Environment Variables
# Copy this file to .env and fill in your API keys

# ── Required ─────────────────────────────────────────
# Deepgram API Key
# Sign up: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your-deepgram-api-key

# Attendee API Key
# Sign up: https://app.attendee.dev/accounts/signup/
ATTENDEE_API_KEY=your-attendee-api-key

# ── Language & Voice ─────────────────────────────────
# Language mode: "ja" (Japanese) or "en" (English)
AGENT_LANG=ja

# Cartesia voice ID for Japanese TTS
# Anime Girl: 1001d611-b1a8-46bd-a5ca-551b23505334 (default, matches Caty's character)
# Japanese Woman Conversational: 2b568345-1d48-4047-b25f-7baccf842eb0
# Sweet Lady: e3827ec5-697a-4b7c-9704-1a23041bbc51
CARTESIA_VOICE_ID=1001d611-b1a8-46bd-a5ca-551b23505334

# ── Security (recommended when using ngrok) ──────────
# Protect /join-meeting endpoint
JOIN_SHARED_TOKEN=
# Protect WebSocket connections
WS_SHARED_TOKEN=

# ── Optional tuning ──────────────────────────────────
ATTENDEE_API_BASE_URL=app.attendee.dev
PORT=5005
ATTENDEE_TIMEOUT_MS=15000
ATTENDEE_RETRY_ATTEMPTS=3
ATTENDEE_RETRY_BASE_MS=800
BODY_LIMIT_BYTES=1000000
SESSION_GRACE_CLOSE_MS=15000

# ── OpenClaw Integration ─────────────────────────────
# Path to OpenClaw workspace (for memory auto-save)
# Default: ~/.openclaw/workspace
# OPENCLAW_WORKSPACE=/path/to/workspace
