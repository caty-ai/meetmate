# AI Meet Participant - Environment Variables
# Copy this file to .env and fill in your API keys

# Deepgram API Key (required)
# Sign up: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your-deepgram-api-key

# Attendee API Key (required)
# Sign up: https://app.attendee.dev/accounts/signup/
ATTENDEE_API_KEY=your-attendee-api-key

# Attendee API Base URL (default: hosted version)
ATTENDEE_API_BASE_URL=app.attendee.dev

# Server port (default: 5005)
PORT=5005

# Optional: protect /join-meeting endpoint (recommended when using ngrok/public tunnel)
# Send via header: x-join-token OR form field: joinToken
JOIN_SHARED_TOKEN=

# Optional: protect WebSocket connection from unknown clients
# Automatically appended to websocket URL as ?token=...
WS_SHARED_TOKEN=

# Optional request/retry tuning
ATTENDEE_TIMEOUT_MS=15000
ATTENDEE_RETRY_ATTEMPTS=3
ATTENDEE_RETRY_BASE_MS=800
BODY_LIMIT_BYTES=1000000
SESSION_GRACE_CLOSE_MS=15000

# Optional Phase1 audio hardening tuning
ECHO_LOOP_COOLDOWN_MS=300
LISTEN_ENDPOINTING_MS=450
LISTEN_UTTERANCE_END_MS=1200
AGENT_TEMPERATURE=0.5
AGENT_MAX_TOKENS=220
