# Environment-only connection and internal-control values live here. Configure
# vendor keys and normal settings in config.json through the localhost settings UI.
# Never commit real secrets; rotate any key/token that leaks.

# ===== Required =====

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# LLM provider: "openclaw" (default; requires Gateway) or "openai-compatible"
LLM_PROVIDER=openclaw

# OpenAI-compatible proxy (required only when LLM_PROVIDER=openai-compatible)
# The API key is environment-only. Configure baseUrl/model in config.json.
OPENAI_COMPATIBLE_API_KEY=
# For stateful OpenAI-compatible gateways (for example a resident agent gateway),
# also set in config.json:
#   "historyMaxTurns": 0
#   "openaiCompatible": { "emptyResponseRetry": false }
# For a trusted local tool-capable gateway only, you may also opt in:
#   "openaiCompatible": { "trustedAgentTools": true }
# Never enable that for external or untrusted meetings.
# For a Hermes Agent api_server only, set the config.json sessionHeader to
# X-Hermes-Session-Id. Leave it empty for every non-Hermes endpoint.
# Optional if the backend can spend a long time inside tools:
# LLM_RESPONSE_TIMEOUT_MS=60000

# Optional LLM tuning (defaults 0.5 / 300):
# AGENT_TEMPERATURE=
# AGENT_MAX_TOKENS=

# STT provider switch: "soniox" (default, adopted 2026-06-23) or "deepgram"
# Revert to Deepgram instantly by setting this to "deepgram" and restarting.
STT_PROVIDER=soniox

# Soniox settings are normally configured in config.json. These value-free
# aliases remain available only for deployment overrides / legacy seeding.
# Optional Soniox tuning:
# SONIOX_MODEL=stt-rt-v5
# SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
# SONIOX_ENDPOINT_SENSITIVITY=          # -1.0 .. 1.0 (higher = endpoints sooner)
# SONIOX_MAX_ENDPOINT_DELAY_MS=         # 500 .. 3000 (default 2000)
# SONIOX_ENDPOINT_LATENCY_LEVEL=        # integer 0 .. 5 (higher = lower latency)
# SONIOX_CONTEXT_TERMS=エージェント名,参加者名,固有名詞   # comma-separated domain terms

# ===== Optional =====

# Slack notifications (default: DM mode — set dmUserId in config.json)
# For channel mode: set notifications.target="channel" in config.json + channel IDs below
# Configure the Slack vendor token in config.json through the localhost settings UI.
SLACK_NOTIFY_CHANNEL=
SLACK_SUMMARY_CHANNEL=
SLACK_STATUS_CHANNEL=

# Server
PORT=5005
TTS_PROVIDER=fish-audio
AGENT_LANG=ja

# Wake word calibration UI/API (disabled by default; set to 1 only when needed)
WAKE_CALIBRATE_ENABLED=

# Shared tokens for /join API and WebSocket auth (generated by meetmate init)
JOIN_SHARED_TOKEN=
WS_SHARED_TOKEN=

# OpenClaw Gateway delegation harness (disabled unless GATEWAY_EVENTS_ENABLED=true)
# GATEWAY_EVENTS_ENABLED=false
# FIRST_TOKEN_DELEGATE_MS=15000
# DELEGATE_REPLY_FRESH_MS=90000
# PARENT_COMPACT_DELAY_MS=5000
# PARENT_COMPACT_MAX_LINES=0   # 0 (default) = gateway real LLM compaction; >0 = legacy line-trim (cannot shrink 1-line giant announces, #98)
# SHORT_UTTERANCE_SKIP_CHARS=24
# CIRCUIT_BREAKER_TIMEOUTS=2
