# AI Meet Participant - Environment Variables

# ── Required: Attendee (Google Meet Bot) ─────────────────────────
ATTENDEE_API_KEY=your_attendee_api_key
ATTENDEE_API_BASE_URL=app.attendee.dev

# ── Required: Deepgram (STT) ────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── TTS Provider Selection ───────────────────────────────────────
# "fish-audio" = Decomposed pipeline (STT → LLM → Fish Audio TTS)
# "deepgram-agent" = Legacy all-in-one (Deepgram Voice Agent API)
TTS_PROVIDER=fish-audio

# ── Required for fish-audio mode ─────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
FISH_AUDIO_API_KEY=your_fish_audio_api_key
FISH_AUDIO_VOICE_ID=                    # Optional: voice model ID from fish.audio
FISH_AUDIO_LATENCY=balanced             # "normal" (best quality) or "balanced" (lower latency)

# ── OpenClaw Gateway (Phase 2 — full Caty experience) ────────────
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here

# ── Server ───────────────────────────────────────────────────────
PORT=5005

# ── Security ─────────────────────────────────────────────────────
JOIN_SHARED_TOKEN=your_random_token_for_join_endpoint
WS_SHARED_TOKEN=your_random_token_for_websocket

# ── Voice Agent Tuning ───────────────────────────────────────────
AGENT_LANG=ja                           # "ja" or "en"
AGENT_TEMPERATURE=0.5
AGENT_MAX_TOKENS=300

# ── Wake Word Detection ──────────────────────────────────────────
# WAKE_MODE: "off" (respond to all), "wake" (require wake word)
WAKE_MODE=off
WAKE_WORDS=ケイティ,けいてぃ,caty,katie,ケイケイ

# ── Legacy: Cartesia voice (for deepgram-agent mode) ─────────────
# Japanese Woman Conversational: 2b568345-1d48-4047-b25f-7baccf842eb0
# Anime Girl: 1001d611-b1a8-46bd-a5ca-551b23505334
# Sweet Lady: e3827ec5-697a-4b7c-9704-1a23041bbc51
CARTESIA_VOICE_ID=1001d611-b1a8-46bd-a5ca-551b23505334

# ── Twilio Phone Transport (port 5006) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                     # e.g. +1XXXXXXXXXX
TWILIO_CALL_SECRET=
TWILIO_PUBLIC_URL=                       # e.g. https://xxxx.ngrok-free.app
TWILIO_ALLOWED_NUMBERS=                  # comma-separated E.164 numbers
TWILIO_DEFAULT_TO=
TWILIO_BRIDGE_PORT=5006

# ── Slack Notification (Phase 2) ──────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=                    # fallback/default channel
SLACK_SUMMARY_CHANNEL=                   # summary + transcript channel (fallback: SLACK_NOTIFY_CHANNEL)
SLACK_STATUS_CHANNEL=                    # status channel (fallback: SUMMARY -> NOTIFY)
SLACK_NOTIFY_ENABLED=true
SUMMARY_ENABLED=true
