{
  "agent": {
    "id": "your-agent-id",
    "name": "YourAgent",
    "displayName": "エージェント名",
    "greeting": "[warm] こんにちは！よろしくお願いします！",
    "model": "openclaw",
    "emotionTags": true,
    "wakeWords": ["エージェント名", "your-agent"],
    "keyterms": ["エージェント名", "YourAgent"],
    "sttWakeVariants": [],
    "ackVariants": ["[soft voice] 了解、すぐ取りかかるね。"],
    "exitFarewell": "[warm] お疲れ様でした。また何かあったら呼んでね！",
    "cancelAck": "[soft voice] 了解、キャンセルしたよ。",
    "progressPings": ["[soft voice] 少々お待ちください…", "[soft voice] もう少しで…"],
    "timeoutFallback": "[empathetic, unhurried] ごめんね、ちょっと時間がかかっちゃって…",
    "avatarUrl": ""
  },
  "gateway": {
    "url": "${OPENCLAW_GATEWAY_URL}",
    "token": "${OPENCLAW_GATEWAY_TOKEN}",
    "warmupTimeoutMs": 8000
  },
  "tts": {
    "provider": "fish-audio",
    "voiceId": "${FISH_AUDIO_VOICE_ID}"
  },
  "stt": {
    "apiKey": "${DEEPGRAM_API_KEY}"
  },
  "slack": {
    "botToken": "${SLACK_BOT_TOKEN}",
    "notifications": {
      "target": "dm",
      "dmUserId": ""
    },
    "notifyChannel": "",
    "summaryChannel": "",
    "statusChannel": ""
  },
  "attendee": {
    "apiKey": "${ATTENDEE_API_KEY}"
  },
  "server": {
    "port": 5005,
    "ngrokDomain": ""
  }
}
