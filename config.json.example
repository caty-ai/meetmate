{
  "agent": {
    "id": "your-agent-id",
    "name": "YourAgent",
    "displayName": "エージェント名",
    "greeting": "(happy) こんにちは！よろしくお願いします！",
    "model": "openclaw",
    "emotionTags": true,
    "wakeWords": ["エージェント名", "your-agent"],
    "keyterms": ["エージェント名", "YourAgent"],
    "sttWakeVariants": [],
    "ackVariants": ["(calm) 了解、すぐ取りかかるね。"],
    "exitFarewell": "(soft) お疲れ様でした。また何かあったら呼んでね！",
    "cancelAck": "了解、キャンセルしたよ。",
    "progressPings": ["(calm) 少々お待ちください…", "(calm) もう少しで…"],
    "timeoutFallback": "(calm) ごめんね、ちょっと時間がかかっちゃって…",
    "avatarUrl": ""
  },
  "gateway": {
    "url": "${OPENCLAW_GATEWAY_URL}",
    "token": "${OPENCLAW_GATEWAY_TOKEN}",
    "warmupTimeoutMs": 8000
  },
  "tts": {
    "provider": "fish-audio",
    "voiceId": "${FISH_AUDIO_VOICE_ID}"
  },
  "stt": {
    "apiKey": "${DEEPGRAM_API_KEY}"
  },
  "slack": {
    "botToken": "${SLACK_BOT_TOKEN}",
    "notifyChannel": "",
    "summaryChannel": "",
    "statusChannel": ""
  },
  "attendee": {
    "apiKey": "${ATTENDEE_API_KEY}"
  },
  "server": {
    "port": 5005,
    "ngrokDomain": ""
  }
}
