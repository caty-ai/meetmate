{
  "agent": {
    "id": "caty",
    "name": "Caty",
    "displayName": "ケイティ",
    "greeting": "(happy) こんにちは！ケイティです。よろしくお願いします！",
    "model": "anthropic/claude-sonnet-4-6",
    "emotionTags": true,
    "wakeWords": ["ケイティ", "けいてぃ", "caty", "katie", "ケイケイ"],
    "keyterms": ["ケイティ", "けいてぃ", "Caty", "Katie"],
    "sttWakeVariants": [],
    "ackVariants": ["(calm) 了解、すぐ取りかかるね。"],
    "exitFarewell": "(soft) お疲れ様でした。また何かあったら呼んでね！",
    "cancelAck": "了解、キャンセルしたよ。",
    "progressPings": ["(calm) 少々お待ちください…", "(calm) もう少しで…"],
    "timeoutFallback": "(calm) ごめんね、ちょっと時間がかかっちゃって…",
    "avatarUrl": ""
  },
  "gateway": {
    "url": "${OPENCLAW_GATEWAY_URL}",
    "token": "${OPENCLAW_GATEWAY_TOKEN}"
  },
  "tts": {
    "provider": "fish-audio",
    "voiceId": ""
  },
  "stt": {
    "apiKey": "${DEEPGRAM_API_KEY}"
  },
  "slack": {
    "botToken": "${SLACK_BOT_TOKEN}",
    "notifyChannel": "",
    "summaryChannel": "",
    "statusChannel": ""
  },
  "attendee": {
    "apiKey": "${ATTENDEE_API_KEY}"
  },
  "server": {
    "port": 5005,
    "ngrokDomain": ""
  }
}
